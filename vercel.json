{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 7 * * 3"
    },
    {
      "path": "/api/cron/programme-rag",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/programme-notify?job=member_reminder",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/programme-notify?job=lead_digest",
      "schedule": "0 8 * * 5"
    },
    {
      "path": "/api/cron/programme-notify?job=day_90",
      "schedule": "30 8 * * *"
    }
  ]
}
